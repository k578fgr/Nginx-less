
upstream app {
    server example.com;
}

server {
    listen 80;
    server_name 158.160.80.40.nip.io;

    access_log /var/log/nginx/nip.access.log;
    root /var/www/html;
    index htpasswd index.nginx-debian.html;
    
    auth_basic "HTTP Basic Authentication";
    auth_basic_user_file /etc/nginx/.htpasswd;


    location / {
        try_files $uri @app;
                            # Путь к файлу htpasswd
    }

    # location /browser {                  Чтобы получить информацию файлом
    #     return 200 "Hello, $browser";
    # }

    location /browser {
        auth_basic "Restricted Content1";
        auth_basic_user_file /etc/nginx/.htpasswd;
        add_header Content-Type text/html;
        return 200 '<html><body>Hello, $browser</body></html>';
    }

    location /rbm_images {
        auth_basic "Restricted Content2";
        auth_basic_user_file /etc/nginx/.htpasswd;
        alias /var/www/rebrain/images;
        allow all;
        deny 10.10.10.10;
  
    }

    location /example {
        auth_basic "Restricted Content3";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://app;                         #Эта строка связана с upstream (2 строка)
        proxy_set_header Host example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

    }
    
    location /noauth/ {                 #Директива noauth отключает
        auth_basic off;         
    }
}
